[Unit]
Description=COTAS INTELIGENTES Python web app
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/cotas-inteligentes
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/cotas-inteligentes.env
ExecStart=/var/www/cotas-inteligentes/.venv/bin/python tools/web_app.py 8088
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
